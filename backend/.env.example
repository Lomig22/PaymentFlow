# Backend environment variables for Sage ↔ Payment Flow integration
# Copy this file to `.env` and fill the secrets

# Express server
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Sage API (sandbox or production)
SAGE_API_BASE=https://sandbox-api.sage.com
SAGE_CLIENT_ID=your_client_id
SAGE_CLIENT_SECRET=your_client_secret

# Sync settings
# Interval in milliseconds for automatic sync from Sage (default: 15 minutes)
SYNC_INTERVAL_MS=900000
