{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "src",
    "pages/landing/LandingPage.tsx",
    "pages/landing/ContactModal.tsx",
    "pages/login/index.tsx",
    "components/Layout.tsx",
    "components/AppHeader.tsx",
    "pages/signup/index.tsx",
    "pages/blog/garage/index.tsx",
    "pages/temoignages/index.tsx",
    "pages/blog/communication/index.tsx",
    "pages/blog/manufacture/index.tsx",
    "pages/blog/index.tsx",
    "pages/blog/optimisation-relance/index.tsx",
    "pages/clients/index.tsx",
    "pages/receivables/index.tsx",
    "pages/reminder-profiles/index.tsx",
    "pages/settings/index.tsx",
    "pages/settings/EmailSettings.tsx",
    "pages/forgot-password/index.tsx",
    "components/Footer.tsx",
    "pages/pricing/index.tsx",
    "pages/crm/index.tsx",
    "pages/mentions-legales/index.tsx",
    "pages/help/index.tsx",
    "pages/reporting-recouvrement/index.tsx",
    "pages/simulateur-dso/index.tsx",
    "pages/personnalisation/index.tsx",
    "pages/privacy/index.tsx",
    "pages/conditions-utilisation/index.tsx",
    "pages/paiement-abonnement/index.tsx",
    "pages/success/index.tsx",
    "pages/reminders/index.tsx"
  ]
}